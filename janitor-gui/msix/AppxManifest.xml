<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest (ADR 0034). The Windows release job (release.yml) copies
  this into the pack layout, substituting @VERSION@ with the 4-part MSIX version
  (crate X.Y.Z -> X.Y.Z.0), then runs `makeappx pack`.

  LOAD-BEARING: `Publisher` below MUST exactly equal the Subject (CN=...) of the
  Azure Trusted Signing certificate profile, or signtool/makeappx rejects the
  package (ADR 0034 Decision 4). It is hardcoded here (the CN is public — it is in
  every signed artifact), NOT freely chosen.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="com.circuitstitch.apps.janitor"
      Publisher="CN=Circuit Stitch, O=Circuit Stitch, L=West Sacramento, S=California, C=US"
      Version="@VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Janitor</DisplayName>
    <PublisherDisplayName>Circuit Stitch</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763.0 (Win10 1809) is the floor for the App Installer update APIs
         used by the in-app "Check for updates" button (ADR 0034 Decision 6). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- Win32 full-trust app (not UWP): EntryPoint is the sentinel
         Windows.FullTrustApplication, paired with the runFullTrust capability. -->
    <Application Id="Janitor" Executable="janitor-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Janitor"
          Description="Ephemeral client onto AWS Secrets Manager - drift detection and safe edits."
          BackgroundColor="transparent"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
