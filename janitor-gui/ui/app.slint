import { ScrollView, LineEdit, Button, ComboBox, Switch, SpinBox, TextEdit } from "std-widgets.slint";

export struct CellView {
    absent: bool,
    dots: string,
    length: string,
    hex: string,
}

// One rendered line of the matrix: a prefix-cluster header, or a data row.
// Assembled in Rust (`rows::matrix_items`) so the view stays logic-free.
export struct MatrixItemView {
    // Header vs data row. Header uses `label` + `count`; a data row uses the rest.
    is-header: bool,
    label: string,        // header: cluster label, e.g. "database.*"
    count: int,           // header: member count
    row-index: int,       // data row: index into MatrixView.rows (reveal coords)
    prefix: string,       // data row: muted name prefix (incl. trailing separator)
    leaf: string,         // data row: bold final segment
    full-name: string,    // data row: complete Entry name (hover reveal / copy, #40)
    badge: string,        // data row: STRING/NUMBER/… ("" = none)
    state: string,        // data row: "Aligned"/"Drift"/"Gap"
    glyph: string,        // data row: order-independent =/≠/∅
    zebra: bool,          // data row: shaded stripe (resets per group)
    // Sticky group headers (#42): how many headers / data rows precede this item
    // in display order (`rows::item_offsets`). A header's pixel top is
    // `headers-before · header-h + rows-before · row-h`, so the pinned overlay can
    // locate each cluster's scroll span without re-summing heights. Unused on data
    // rows (the overlay pins headers only).
    headers-before: int,
    rows-before: int,
    cells: [CellView],
}

export struct AppItem {
    name: string,
    subtitle: string,
    drift: string,
    selected: bool,
}

export struct EnvRow {
    environment: string,
    account_id: string,
    region: string,
    secret_id: string,
    permission_set: string,
    // Which AWS-family Method backs this Environment (ADR 0031), as a short label
    // ("SM" / "SSM"). Display-only — a location tag, never a Value.
    method: string,
}

// Shared palette helpers so per-row colour logic isn't duplicated or threaded
// through brittle `parent.parent` chains. State lives in the dot/glyph only.
export global Palette {
    pure public function dot-color(state: string) -> color {
        return state == "Gap" ? #6b7280 : state == "Drift" ? #e0a356 : #5db07a;
    }
}

export component MainWindow inherits Window {
    title: "Janitor";
    // Runtime window icon (taskbar / alt-tab / title bar). A generated PNG, not
    // the dense ~1.75 MiB source SVG — see ADR 0022. icon.svg is the source of
    // truth; janitor-gui/assets/gen-icons.sh regenerates this set.
    icon: @image-url("../assets/icons/256.png");
    min-width: 800px;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: root.dark ? #14161a : #f4f5f7;

    in property <[string]> environments;
    in property <[MatrixItemView]> items;
    in property <[AppItem]> apps;

    // Writable from the view so a press-release can clear the reveal instantly
    // (the round-trip fills `revealed-text`; release zeroes it — press-and-hold
    // momentary reveal). Rust still pushes via `set_revealed_*`.
    in-out property <int> revealed-row: -1;
    in-out property <int> revealed-col: -1;
    in-out property <string> revealed-text;

    callback reveal-cell(int, int);
    // The per-cell reveal gate (issue #47): backed by the exhaustively-tested pure
    // `reveal::is_revealed` in Rust, so the security rule — un-mask EXACTLY the one
    // targeted cell, never a whole row/column — is tested Rust, not an inline
    // predicate here. A cell binds `is-revealed` to this; both coords must match the
    // single revealed coordinate (`-1` sentinel when nothing is revealed).
    pure callback is-cell-revealed(int, int, int, int) -> bool;
    // Release/cancel of a press-held reveal — clears the reveal guard and logs the
    // hide. The view also zeroes revealed-row/col/text inline so the hide is instant.
    callback hide-cell();
    // Right-click → Copy a Value cell's plaintext to the clipboard (row, col into
    // MatrixView). The Value rides back from the worker; the confirmation never
    // logs it (issue #59 tracks the ADR 0005 auto-clear hardening).
    callback copy-value(int, int);
    // Copy a row's full Entry name to the OS clipboard (#40, ADR 0005). The name
    // is metadata, never a Value.
    callback copy-entry(string);
    callback select-app(int);
    // Auth / load state (driven by the worker). status: one of
    // "unauth" | "signing" | "loading" | "loaded" | "error".
    in property <string> status: "unauth";
    // Which content the main pane shows, decided by `pane::main_pane` (folds in
    // whether any Applications exist). One of "signin" | "signing" | "loading" |
    // "empty-apps" | "matrix" | "error".
    in property <string> pane: "signin";
    // Pane-derived chrome (issue #47), computed in Rust (pane::MainPane) instead of
    // duplicated `?:` ladders here: the top-bar title and the centered body copy
    // shown on a non-matrix / non-empty pane (the latter folds in `status-message`).
    in property <string> pane-title;
    in property <string> body-copy;
    in property <string> status-message;        // banner text for "error"/"signing"
    callback sign-in();
    callback refresh();
    in-out property <bool> settings-open: false;
    in-out property <string> sso-start-url;
    in-out property <string> sso-region;
    callback toggle-settings();
    callback save-sso();
    callback add-app(string);
    callback remove-app(int);
    // Discovery / Manage (ADR 0013): create an Application from the sidebar and
    // open its non-modal Manage window; open Manage for the selected app.
    callback new-app-managed(string);
    callback manage-selected();

    in property <bool> dark: true;
    in-out property <bool> grouped: true;
    // Read-write mode (ADR 0004 / ADR 0032): off by default (read-only) and never
    // persisted. The worker is the authoritative lock; this is the deliberate unlock
    // toggle, kept in sync by the worker's `ReadWriteModeChanged` ack. While off, no
    // mutating AWS call is reachable.
    in-out property <bool> read-write: false;
    callback set-theme(bool);
    callback set-sort(int);
    callback set-grouped(bool);
    callback set-read-write(bool);
    // Persist a resized ENTRY column width (#42) — fired on drag release, routed to
    // Config::set_entry_column_width (view-state, never a Value).
    callback commit-entry-width(length);
    // The matrix body's current vertical scroll offset (px from the top), driven by
    // the body ScrollView's `viewport-y`. Sticky group headers (#42) read it to pin
    // the active cluster's header; `in-out` so a view test can drive it directly.
    in-out property <length> scroll-y: 0px;
    // The env region's current horizontal scroll offset (px scrolled right from
    // the leftmost column; `env-body.viewport-x` is its negation). Mirrored out
    // from the body Flickable's `viewport-x` so a view test can observe a
    // scrollbar drag (issue #60); the header band follows the SAME `viewport-x`
    // via its existing mirror, so the freeze-pane stays aligned.
    in-out property <length> scroll-x: 0px;

    // Horizontal env-scrollbar geometry (issue #60), backed by the pure,
    // unit-tested `scrollbar::*` in Rust (set via `ui.on_sb_*`). The env-body
    // Flickable is non-interactive (so cell press-and-hold reveal + right-click
    // work), which dropped ADR 0023 drag-scroll; the bar restores reaching the
    // off-screen Comparison Columns without re-enabling the Flickable or adding
    // wheel handling. `sb-visible`: shown only when the columns overflow the
    // visible band (the env-floor regime). `sb-thumb-len`/`sb-thumb-offset`: the
    // thumb's pixel length / left offset. `sb-scroll-from-thumb`: the drag
    // inverse — a dragged thumb position back to a scroll distance.
    pure callback sb-visible(length, length) -> bool;
    pure callback sb-max-scroll(length, length) -> length;
    pure callback sb-thumb-len(length, length, length, length) -> length;
    pure callback sb-thumb-offset(length, length, length, length) -> length;
    pure callback sb-scroll-from-thumb(length, length, length, length) -> length;
    // Scrollbar chrome metrics: the track/thumb thickness and the minimum thumb
    // length (so a many-column matrix still has a grabbable thumb).
    property <length> scrollbar-h: 12px;
    property <length> scrollbar-min-thumb: 32px;

    // --- Chrome (issue #23): non-secret context strings pushed from Rust. No
    // Values ever — identity strings, the Application name/breadcrumb, the Secret
    // ARN (a location, not a secret), the snapshot timestamp, and Aligned/Drift/Gap
    // COUNTS only. v1 ships read-only (ADR 0004); `identity` / `session-remaining`
    // are best-effort and render a graceful placeholder when not yet plumbed. ---
    in property <bool> read-only: true;
    in property <string> identity;          // signed-in identity ("" → placeholder)
    in property <string> session-remaining; // SSO token time left ("" → "—")
    in property <string> app-title;         // selected Application name (breadcrumb)
    in property <string> secret-arn;        // representative Mapping secret_id
    in property <string> snapshot-label;    // "Snapshot HH:MM / N min ago" ("" hidden)
    in property <int> aligned-count;
    in property <int> drift-count;
    in property <int> gap-count;

    // Diagnostic Log (ADR 0017): the only diagnostic surface. `log-text` is the
    // pre-rendered, level-filtered, error-safe stream (Rust polls the in-memory
    // buffer into it). Collapsible; never touches stdout/stderr/disk.
    in property <string> log-text;
    // The newest log line, shown inline on the collapsed strip as the in-app
    // status area (e.g. "NAME[env] copied to clipboard"). Error-safe, never a Value.
    in property <string> log-latest;
    in-out property <bool> log-open: false;
    callback set-log-filter(int);   // 1=Error 2=Warn 3=Info (max verbosity shown)
    callback clear-log();

    // --- Matrix table metrics: row height derives from font-size + padding (no
    // magic 48px); column widths drive the frozen/scroll split. ---
    property <length> name-fs: 14px;
    property <length> sub-fs: 11px;
    property <length> row-pad: 8px;
    // Single-line ENTRY cell (#38): one name line + symmetric vertical padding.
    // State no longer adds a second line — it lives in the STATE glyph column.
    property <length> row-h: root.name-fs + 2 * root.row-pad;
    property <length> header-h: root.sub-fs + 2 * root.row-pad;
    // ENTRY column width (#42). `in-out` so Rust seeds the persisted width on
    // launch and the drag handle updates it live; `commit-entry-width` persists it
    // on release. `entry-min` is the resize floor — the column never shrinks below
    // it, and the persisted value is clamped to it (Config::set_entry_column_width).
    in-out property <length> entry-w: 300px;
    property <length> entry-min: 200px;
    // Width of the right-edge grab zone where the resize drag arms (#42).
    property <length> entry-handle-zone: 12px;
    property <length> state-w: 46px;
    // Comparison Column content floor (ADR 0023): wide enough for a cell's
    // `dot · mask · length · hex`. Columns stretch above this to fill the env
    // width; at the floor they stop shrinking and the env region scrolls.
    property <length> env-floor: 200px;
    // Window chrome insets, named so the env column-sizing (`matrix.col-w`) can
    // derive the available env width from the window width WITHOUT reading any
    // element inside the matrix (which would cycle through the env Flickable's
    // viewport-width = col-w·N). Single source of truth — also drive the sidebar
    // width and the main-pane padding below.
    property <length> sidebar-w: 240px;
    property <length> pane-pad: 16px;
    // Sidebar list rows (Applications + the add-app row) share one fixed height
    // so the "+ new application" row lines up as a list item, not a stray bar.
    property <length> sidebar-row-h: 48px;
    // Stripe shades + chrome. State never tints the row — it lives in the dot /
    // glyph / pill only.
    property <color> stripe-a: root.dark ? #15181d : #ffffff;
    property <color> stripe-b: root.dark ? #191d24 : #f0f2f5;
    property <color> header-bg: root.dark ? #0e1115 : #e4e7eb;
    property <color> grid: root.dark ? #23272f : #d8dce2;

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: root.sidebar-w;
            background: #0f1115;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text { text: "APPLICATIONS"; color: #6b7280; font-size: 11px; }
                Rectangle {
                    height: root.sidebar-row-h;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 4px;
                        new-app-name := LineEdit {
                            placeholder-text: "New application";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "+";
                            clicked => {
                                root.new-app-managed(new-app-name.text);
                                new-app-name.text = "";
                            }
                        }
                    }
                }
                for app[i] in apps : Rectangle {
                    height: root.sidebar-row-h;
                    background: app.selected ? #1b2330 : (atouch.has-hover ? #161a20 : transparent);
                    atouch := TouchArea { clicked => { root.select-app(i); } }
                    HorizontalLayout {
                        padding: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: app.name; color: white; }
                            Text { text: app.subtitle; color: #6b7280; font-size: 11px; }
                        }
                        Text { text: app.drift; color: #e0a356; font-size: 11px; }
                    }
                }
            }
        }
        // Main pane
        VerticalLayout {
            padding: root.pane-pad;
            spacing: 6px;

            // Top bar (issue #23): a read-only badge (v1 ships read-only — ADR
            // 0004), the signed-in identity, an Application breadcrumb, then the
            // pane title and the action buttons. Identity / ARN / counts only —
            // never a Value.
            HorizontalLayout {
                spacing: 8px;
                // Read-only badge — always present (v1 has no read-write mode).
                Rectangle {
                    background: root.dark ? #232a36 : #dfe4ec;
                    border-radius: 4px;
                    accessible-role: text;
                    accessible-label: "topbar-readonly";
                    vertical-stretch: 0;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        padding-top: 3px; padding-bottom: 3px;
                        Text {
                            text: "READ-ONLY";
                            color: #9aa0aa; font-size: 10px; font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
                // Signed-in identity ("" → a memory-only placeholder).
                Text {
                    accessible-role: text;
                    accessible-label: "topbar-identity";
                    text: root.identity != "" ? root.identity : "memory-only session";
                    color: root.identity != "" ? #c8ccd4 : #6b7280;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                // Application breadcrumb.
                Text {
                    accessible-role: text;
                    accessible-label: "topbar-breadcrumb";
                    text: root.app-title != "" ? "/ " + root.app-title : "";
                    color: #8a8f98; font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.pane-title;
                    color: #c8ccd4;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                if root.pane == "signin" || root.pane == "error" : Button {
                    text: "Sign in";
                    clicked => { root.sign-in(); }
                }
                if root.pane == "matrix" : Button {
                    text: "Refresh";
                    clicked => { root.refresh(); }
                }
                Button {
                    text: "Manage";
                    clicked => { root.manage-selected(); }
                }
                Button {
                    text: root.settings-open ? "Close settings" : "Settings";
                    clicked => { root.toggle-settings(); }
                }
            }

            if root.pane == "error" || (root.pane == "signing" && root.status-message != "") : Rectangle {
                height: 32px;
                background: root.status == "error" ? #3a1d1d : #1d2a3a;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.status-message;
                        color: root.status == "error" ? #e0a3a3 : #a3c0e0;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.pane == "matrix" : matrix := VerticalLayout {
                spacing: 6px;

                // Column-sizing model (ADR 0023): each Comparison Column is
                // `col-w` wide, sharing the available env width equally and
                // stretching to fill it down to the `env-floor`; below the floor
                // it holds the floor and the env region scrolls horizontally.
                // `available` is computed from the WINDOW width minus the fixed
                // chrome (sidebar + pane padding) and the frozen ENTRY/STATE
                // columns — never from any element inside the matrix, because the
                // env Flickable's max-width is its viewport-width (= col-w·N), so
                // reading e.g. the header band's width would cycle back into
                // col-w (Slint panics "Recursion detected"). `root.width` is set
                // top-down by the window, so it's the one cycle-free source. One
                // value drives BOTH the header band and the body, so the env-name
                // header is metric-locked above its own cells and can never drift
                // (ADR 0023 freeze-pane).
                property <length> available:
                    root.width - root.sidebar-w - 2 * root.pane-pad - root.state-w - root.entry-w;
                property <length> col-w:
                    max(root.env-floor, self.available / max(1, environments.length));
                property <length> envs-w: self.col-w * environments.length;

                // Main header (issue #23): the Application title, the Secret ARN
                // subtitle (a location identifier, not a secret — OK to show), and
                // a point-in-time "Snapshot HH:MM / N min ago" last-refresh stamp
                // (ADR 0005 — the matrix is an explicit snapshot, no background
                // polling). Distinct from the top bar; sits directly above the
                // matrix toolbar.
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.app-title != "" ? root.app-title : "Drift matrix";
                            color: root.dark ? white : #14161a;
                            font-size: 16px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            accessible-role: text;
                            accessible-label: "header-snapshot";
                            text: root.snapshot-label != "" ? root.snapshot-label : "Not refreshed yet";
                            color: #6b7280; font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        accessible-role: text;
                        accessible-label: "header-arn";
                        text: root.secret-arn != "" ? root.secret-arn : "—";
                        color: #6b7280; font-size: 11px;
                        overflow: elide;
                    }
                }

                // Group-by-prefix toggle (default on).
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Group by prefix";
                        color: #8a8f98;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked: root.grouped;
                        toggled => { root.set-grouped(self.checked); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Header band: frozen ENTRY + STATE, then env names that scroll
                // horizontally in lockstep with the body (viewport-x bound below).
                HorizontalLayout {
                    Text {
                        text: "STATE"; color: #8a8f98; font-size: 11px;
                        min-width: root.state-w; max-width: root.state-w;
                        horizontal-alignment: center; vertical-alignment: center;
                        accessible-label: "statehdr";
                    }
                    // ENTRY header — fixed to the (resizable) column width, with a
                    // drag handle on its right edge (#42). Dragging resizes `entry-w`
                    // (floored at `entry-min`); the env columns reflow because
                    // `matrix.available` derives from `entry-w`.
                    Rectangle {
                        min-width: root.entry-w; max-width: root.entry-w;
                        accessible-role: text;
                        accessible-label: "entryhdr";
                        Text {
                            text: "ENTRY"; color: #8a8f98; font-size: 11px;
                            width: 100%; height: 100%;
                            vertical-alignment: center;
                        }
                        // A thin grip line at the right edge — the visual affordance,
                        // brighter when hovered/dragged near it.
                        Rectangle {
                            accessible-role: text;
                            accessible-label: "entry-resize-handle";
                            x: parent.width - 6px;
                            width: 2px;
                            height: parent.height * 60%;
                            y: (parent.height - self.height) / 2;
                            background: entry-resize.resizing
                                || (entry-resize.has-hover
                                    && entry-resize.mouse-x >= parent.width - root.entry-handle-zone)
                                ? #8a8f98 : #3a3f48;
                        }
                        // Drag sensor, LEFT-anchored to the ENTRY column's fixed left
                        // edge (`x: 0`). Because that origin never moves when `entry-w`
                        // changes, `mouse-x` is the pointer's distance from the fixed
                        // left edge — independent of the column width — so the resizing
                        // column can't feed back into the measurement. (A handle pinned
                        // to the *moving* right edge instead would jitter/overshoot
                        // under continuous motion: each `moved` would read an `entry-w`
                        // a frame ahead of the handle geometry `mouse-x` is measured
                        // against.) The new width is the pointer position plus the grab
                        // offset captured at press (so the edge tracks the cursor with
                        // no jump), floored at `entry-min`. Only arms when the press
                        // lands in the right-edge handle zone; release persists.
                        entry-resize := TouchArea {
                            x: 0;
                            width: 100%;
                            height: 100%;
                            mouse-cursor: self.mouse-x >= parent.width - root.entry-handle-zone
                                ? MouseCursor.ew-resize : MouseCursor.default;
                            property <bool> resizing;
                            property <length> grab-offset;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left
                                    && e.kind == PointerEventKind.down
                                    && self.mouse-x >= parent.width - root.entry-handle-zone) {
                                    self.resizing = true;
                                    self.grab-offset = root.entry-w - self.mouse-x;
                                }
                                if (e.kind == PointerEventKind.up
                                    || e.kind == PointerEventKind.cancel) {
                                    if (self.resizing) {
                                        self.resizing = false;
                                        root.commit-entry-width(root.entry-w);
                                    }
                                }
                            }
                            moved => {
                                if (self.resizing) {
                                    root.entry-w = max(root.entry-min, self.mouse-x + self.grab-offset);
                                }
                            }
                        }
                    }
                    // Clip wrapper (ADR 0023): decouples the env-head Flickable's
                    // max-width (= its viewport-width = col-w·N) from the header
                    // band — exactly as the body's ScrollView does for env-body.
                    // Since `col-w` is derived from the window width, a finite
                    // col-w-dependent max-width propagating up to that width is a
                    // binding loop (Slint: deprecated, may panic). The Rectangle's
                    // own max-width is infinite, so it stops the propagation and the
                    // window still widens freely (ADR 0020). `horizontal-stretch`
                    // makes the wrapper fill the band's slack; `alignment: start` on
                    // the inner row pins the columns to a common left origin in both
                    // bands; `viewport-x` keeps header & body scrolling in lockstep.
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        env-head := Flickable {
                            width: 100%;
                            height: 100%;
                            interactive: false;
                            // Structural anchor for the view-test harness (ADR
                            // 0021), position-only — a Flickable needs a role to
                            // carry a label.
                            accessible-role: text;
                            accessible-label: "envhead-band";
                            viewport-x: env-body.viewport-x;
                            viewport-width: matrix.envs-w;
                            viewport-height: self.height;
                            HorizontalLayout {
                                alignment: start;
                                for env[j] in environments : Text {
                                    text: env; color: #c8ccd4; font-size: 11px;
                                    min-width: matrix.col-w; max-width: matrix.col-w;
                                    vertical-alignment: center;
                                    accessible-label: "envhead-" + j;
                                }
                            }
                        }
                    }
                }

                // Body: a vertical ScrollView holds the frozen column + the
                // horizontally-flickable env region (they scroll vertically
                // together; only the env region scrolls horizontally). It is wrapped
                // in a clipping container so the sticky group-header overlay (#42)
                // can pin atop the scrolled content as a sibling drawn over it.
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    body-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        // Mirror the live scroll offset out to `scroll-y` (px from
                        // the top; viewport-y is ≤ 0 as you scroll down) so the
                        // sticky overlay — outside the scrolled content — reads it.
                        changed viewport-y => { root.scroll-y = -self.viewport-y; }
                        HorizontalLayout {
                        // FROZEN: ENTRY (2-line) + STATE glyph, per item. Pinned to
                        // the exact frozen width (state-w + entry-w) so the body's
                        // env region starts at the SAME x as the header band's
                        // (whose frozen side is fixed-width Texts). Without the pin a
                        // VerticalLayout defaults to stretch 1 and competes 50/50
                        // with the stretch-1 env-body Flickable, ballooning to half
                        // the viewport and pushing the env cells right of their
                        // headers — a window-width-dependent drift (issue #41 AC3).
                        // (min == max, not stretch:0, because the per-row background
                        // Rectangles don't propagate the cells' min-width, so a bare
                        // stretch:0 would instead collapse the column to 0.)
                        VerticalLayout {
                            min-width: root.state-w + root.entry-w;
                            max-width: root.state-w + root.entry-w;
                            for item[i] in items : Rectangle {
                                height: item.is-header ? root.header-h : root.row-h;
                                background: item.is-header ? root.header-bg
                                    : (item.zebra ? root.stripe-b : root.stripe-a);
                                // Grid baseline.
                                Rectangle {
                                    y: parent.height - 1px; height: 1px;
                                    background: root.grid;
                                }
                                if item.is-header : HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px;
                                    Text {
                                        text: item.label + "   " + item.count;
                                        color: #8a8f98; font-size: root.sub-fs;
                                        font-weight: 700; vertical-alignment: center;
                                    }
                                }
                                if !item.is-header : HorizontalLayout {
                                    // STATE glyph column — frozen leftmost, and the
                                    // row's SOLE state carrier (#38): the coloured
                                    // =/≠/∅ glyph. No dot or state word elsewhere.
                                    Rectangle {
                                        min-width: root.state-w; max-width: root.state-w;
                                        accessible-role: text;
                                        accessible-label: "state-cell";
                                        Text {
                                            text: item.glyph;
                                            color: Palette.dot-color(item.state);
                                            font-size: 16px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // ENTRY cell — one line: muted prefix + bold leaf
                                    // + type badge. Dot and state word removed (#38),
                                    // so the row collapses to single-line height. The
                                    // padding lives on a wrapping VerticalLayout, not
                                    // on the inner HorizontalLayout — padding directly
                                    // on a box layout holding `overflow: elide` Texts
                                    // blanks them (Slint layout quirk).
                                    Rectangle {
                                        min-width: root.entry-w; max-width: root.entry-w;
                                        accessible-role: text;
                                        accessible-label: "entry-cell";
                                        clip: true;
                                        // Right-click actions. Copy (the full Entry
                                        // name — metadata) is the only live one in
                                        // read-only v1; Edit / View history / Delete are
                                        // disabled placeholders (v2 / unbuilt, ADR 0004/
                                        // 0006). Left-click no longer copies (#40's
                                        // click-copy is gone) — copy moved to this menu.
                                        ectx := ContextMenuArea {
                                            Menu {
                                                MenuItem {
                                                    title: "Copy";
                                                    activated => { root.copy-entry(item.full-name); }
                                                }
                                                MenuItem { title: "Edit"; enabled: false; }
                                                MenuItem { title: "View history"; enabled: false; }
                                                MenuItem { title: "Delete"; enabled: false; }
                                            }
                                            VerticalLayout {
                                                padding: root.row-pad;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: item.prefix; color: #6b7280;
                                                        font-size: root.name-fs; overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: item.leaf; color: root.dark ? white : #14161a;
                                                        font-size: root.name-fs; font-weight: 700;
                                                        overflow: elide; vertical-alignment: center;
                                                    }
                                                    if item.badge != "" : Rectangle {
                                                        background: root.dark ? #232a36 : #dfe4ec;
                                                        border-radius: 3px;
                                                        HorizontalLayout {
                                                            padding-left: 5px; padding-right: 5px;
                                                            Text {
                                                                text: item.badge; color: #9aa0aa;
                                                                font-size: 9px; vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                            }
                                            // Hover reveals the FULL (un-stripped) Entry
                                            // name — the safety net for a prefix-stripped /
                                            // elided ENTRY cell. Names are metadata, never
                                            // Values.
                                            if ehover.has-hover : Rectangle {
                                                background: root.dark ? #1b2330 : #e8ebf0;
                                                HorizontalLayout {
                                                    padding-left: root.row-pad;
                                                    padding-right: root.row-pad;
                                                    Text {
                                                        text: item.full-name;
                                                        color: root.dark ? white : #14161a;
                                                        font-size: root.name-fs;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                        accessible-label: "entry-full";
                                                    }
                                                }
                                            }
                                            // Hover drives the full-name overlay; a right
                                            // press opens the menu (the TouchArea grabs the
                                            // right-click, so trigger it directly). No
                                            // left-click action.
                                            ehover := TouchArea {
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right
                                                        && e.kind == PointerEventKind.down) {
                                                        ectx.show({ x: self.mouse-x, y: self.mouse-y });
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // ENV: horizontally-flickable cells, aligned row-for-row.
                        env-body := Flickable {
                            // EXPERIMENT: non-interactive so the cell TouchAreas get
                            // real sustained presses (press-and-hold reveal) and
                            // right-clicks reach the ContextMenuArea. Trade-off: loses
                            // horizontal drag-scroll of env columns (ADR 0023).
                            interactive: false;
                            horizontal-stretch: 1;
                            viewport-width: matrix.envs-w;
                            viewport-height: self.height;
                            // Mirror the live horizontal offset out to `scroll-x`
                            // (px scrolled right; viewport-x is ≤ 0) so a view test
                            // can observe a scrollbar drag / shift-wheel. The
                            // scrollbar writes `viewport-x` directly; the header
                            // band reads the same value, so the freeze-pane holds.
                            changed viewport-x => { root.scroll-x = -self.viewport-x; }
                            VerticalLayout {
                                for item[i] in items : Rectangle {
                                    height: item.is-header ? root.header-h : root.row-h;
                                    background: item.is-header ? root.header-bg
                                        : (item.zebra ? root.stripe-b : root.stripe-a);
                                    Rectangle {
                                        y: parent.height - 1px; height: 1px;
                                        background: root.grid;
                                    }
                                    if !item.is-header : HorizontalLayout {
                                        // Pin the fixed-width env columns to a left
                                        // origin so they line up with the header band
                                        // (which does the same) at every width.
                                        alignment: start;
                                        for cell[j] in item.cells : Rectangle {
                                            min-width: matrix.col-w; max-width: matrix.col-w;
                                            // Structural test anchor (ADR 0021),
                                            // position-only — never the Value.
                                            accessible-role: text;
                                            accessible-label: "envcell-" + j;
                                            // The reveal IS the held state: a press fills
                                            // revealed-row/col/text (worker round-trip);
                                            // release/cancel zeroes them. `pressed`/
                                            // `has-hover` can't gate it — inside the
                                            // interactive env-body Flickable the child
                                            // TouchArea gets pointer *events* but not the
                                            // grab, so `pressed` is stuck false. So
                                            // revealed-row/col itself is the source of
                                            // truth (press-and-hold momentary reveal —
                                            // THREAT-MODEL / ADR 0003). The gate itself is
                                            // the tested pure `reveal::is_revealed` (#47),
                                            // reached via the `is-cell-revealed` callback so
                                            // the un-mask-exactly-one rule lives in Rust.
                                            property <bool> is-revealed:
                                                root.is-cell-revealed(root.revealed-row, root.revealed-col, item.row-index, j);
                                            // Right-click actions (native menu). Copy is
                                            // the only live one in read-only v1 (ADR 0004);
                                            // Edit / View history are disabled placeholders
                                            // (v2 / unbuilt). Copy is disabled on an absent
                                            // (Gap) cell — nothing to copy.
                                            ctx := ContextMenuArea {
                                                Menu {
                                                    MenuItem {
                                                        title: "Copy";
                                                        enabled: !cell.absent;
                                                        activated => { root.copy-value(item.row-index, j); }
                                                    }
                                                    MenuItem { title: "Edit"; enabled: false; }
                                                    MenuItem { title: "View history"; enabled: false; }
                                                }
                                                // Padding lives on this wrapping VerticalLayout,
                                                // NOT on the inner HorizontalLayout — padding
                                                // directly on a box layout holding an
                                                // `overflow: elide` Text blanks it (Slint layout
                                                // quirk; same workaround as the ENTRY cell). That
                                                // blank is what hid both the masked dots AND the
                                                // revealed plaintext — the real reveal regression.
                                                VerticalLayout {
                                                    padding: root.row-pad;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        if cell.absent : Text {
                                                            text: "— absent"; color: #4b5563;
                                                            horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                        }
                                                        if !cell.absent : Rectangle {
                                                            min-width: 6px; max-width: 6px;
                                                            height: 6px; border-radius: 3px;
                                                            background: Palette.dot-color(item.state);
                                                        }
                                                        if !cell.absent : Text {
                                                            text: is-revealed ? root.revealed-text : cell.dots;
                                                            color: is-revealed ? #ffd479 : #6b7280;
                                                            overflow: elide; horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                        }
                                                        if !cell.absent : Text {
                                                            text: cell.length; color: #6b7280;
                                                            vertical-alignment: center;
                                                        }
                                                        if !cell.absent : Text {
                                                            text: cell.hex; color: #9aa0aa;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // Hover / reveal as a brightness delta
                                                // painted on top, so it reads on both
                                                // stripe shades (no fixed color).
                                                Rectangle {
                                                    background: is-revealed ? #ffffff2e
                                                        : (touch.has-hover ? #ffffff14 : transparent);
                                                }
                                                // Press-and-hold reveals: a LEFT-button
                                                // press starts the round-trip; release OR a
                                                // cancelled grab (pointer left / focus stolen)
                                                // clears the plaintext at once. Right-clicks
                                                // aren't `down`-handled, so they fall through
                                                // to the ContextMenuArea.
                                                touch := TouchArea {
                                                    pointer-event(e) => {
                                                        // Left press-and-hold reveals; right press
                                                        // opens the menu (the TouchArea grabs the
                                                        // right-click, so trigger the menu directly).
                                                        if (e.button == PointerEventButton.left
                                                            && e.kind == PointerEventKind.down) {
                                                            root.reveal-cell(item.row-index, j);
                                                        }
                                                        if (e.button == PointerEventButton.right
                                                            && e.kind == PointerEventKind.down) {
                                                            ctx.show({ x: self.mouse-x, y: self.mouse-y });
                                                        }
                                                        if (e.kind == PointerEventKind.up
                                                            || e.kind == PointerEventKind.cancel) {
                                                            root.hide-cell();
                                                            root.revealed-row = -1;
                                                            root.revealed-col = -1;
                                                            root.revealed-text = "";
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    // Sticky group headers (#42): while any row of a prefix cluster
                    // occupies the top of the scroll area, that cluster's header pins
                    // here, above the scrolled content. Each header self-selects when
                    // `scroll-y` falls in its cluster's span
                    // `[top, top + header-h + count·row-h)` — `top` derived from the
                    // precomputed headers-before/rows-before counts (rows::item_offsets)
                    // and the in-view heights (the ADR 0023 single source of truth).
                    // Contiguous clusters hand off seamlessly (this `end` == the next
                    // `top`); over a lone row (no cluster) nothing pins. As the next
                    // header arrives the outgoing one slides up (negative y) while the
                    // incoming in-flow header rises beneath it — the classic push.
                    // Per-item container holds the conditional pinned header (Slint
                    // can't put an `if` directly after `for :`, so it lives as a
                    // child). The container fills the body and is transparent with no
                    // TouchArea, so it never intercepts cell presses below.
                    for item[i] in items : Rectangle {
                        width: 100%;
                        height: 100%;
                        if (item.is-header
                            && root.scroll-y >= item.headers-before * root.header-h
                                + item.rows-before * root.row-h
                            && root.scroll-y < (item.headers-before + 1) * root.header-h
                                + (item.rows-before + item.count) * root.row-h)
                          : Rectangle {
                            property <length> cluster-end:
                                (item.headers-before + 1) * root.header-h
                                + (item.rows-before + item.count) * root.row-h;
                            accessible-role: text;
                            accessible-label: "pinned-" + item.label;
                            x: 0;
                            y: min(0px, self.cluster-end - root.scroll-y - root.header-h);
                            width: 100%;
                            height: root.header-h;
                            background: root.header-bg;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                Text {
                                    text: item.label + "   " + item.count;
                                    color: #8a8f98; font-size: root.sub-fs;
                                    font-weight: 700; vertical-alignment: center;
                                }
                            }
                            // Grid baseline, matching the in-flow header row.
                            Rectangle {
                                y: parent.height - 1px; height: 1px;
                                background: root.grid;
                            }
                        }
                    }
                }

                // Always-visible horizontal scrollbar for the env region (issue
                // #60). Shown only when the Comparison Columns overflow the visible
                // band (the ADR 0023 env-floor regime); it drives env-body's
                // viewport-x and the header band follows via the existing mirror.
                // It does NOT re-enable the interactive Flickable (that breaks
                // press-hold / right-click) and adds no wheel handling (shift+wheel
                // already scrolls sideways). The track's TouchArea is a SIBLING of
                // the non-interactive env-body, so it owns its own pointer grab and
                // the drag works; all thumb math is the pure `scrollbar::*` (ADR 0003).
                //
                // The row is ALWAYS present (and collapses to zero HEIGHT when the
                // columns fit) rather than guarded by an `if` on the overflow: an
                // `if` keyed on `envs-w`/`available` would make the row's PRESENCE —
                // and thus `matrix.layoutinfo-h` — depend on `envs-w`, closing the
                // ADR 0023 binding loop (envs-w → layoutinfo-h → root.width →
                // available → col-w → envs-w). Visibility lives on the vertical axis
                // (height), which never feeds back into the env width.
                HorizontalLayout {
                    vertical-stretch: 0;
                    // Spacer under the frozen ENTRY+STATE columns so the track lines
                    // up with the env region (same left origin as the header band).
                    Rectangle {
                        min-width: root.state-w + root.entry-w;
                        max-width: root.state-w + root.entry-w;
                    }
                    sb-track := Rectangle {
                        horizontal-stretch: 1;
                        // Collapse to zero height when the columns fit (so the bar is
                        // shown only on overflow) — a vertical-axis toggle, loop-safe.
                        height: root.sb-visible(matrix.envs-w, matrix.available) ? root.scrollbar-h : 0px;
                        background: root.dark ? #1b1f26 : #e0e3e8;
                        border-radius: root.scrollbar-h / 2;
                        accessible-role: text;
                        accessible-label: "env-scrollbar-track";
                        // The thumb's width/x derive from `envs-w`; `clip: true`
                        // makes this Rectangle take its own (stretch) size and stops
                        // that geometry bubbling up into the matrix's layout-info →
                        // root.width → available → col-w → envs-w binding loop — the
                        // same shield the env-head clip wrapper provides (ADR 0023).
                        clip: true;
                        // The track spans exactly the visible env band, so its width
                        // and the viewport width are both `matrix.available` — a
                        // window-derived, cycle-free value, never read from inside the
                        // matrix subtree (the ADR 0023 binding-loop rule).
                        property <length> track-w: matrix.available;
                        property <length> content-w: matrix.envs-w;
                        property <length> max-scroll: root.sb-max-scroll(self.content-w, self.track-w);
                        property <length> thumb-len:
                            root.sb-thumb-len(self.track-w, self.track-w, self.content-w, root.scrollbar-min-thumb);

                        sb-thumb := Rectangle {
                            accessible-role: text;
                            accessible-label: "env-scrollbar-thumb";
                            // Left offset derived from the live scroll offset
                            // (−viewport-x); the thumb follows shift-wheel and drag
                            // alike because both move viewport-x.
                            x: root.sb-thumb-offset(sb-track.track-w, sb-track.thumb-len,
                                -env-body.viewport-x, sb-track.max-scroll);
                            width: sb-track.thumb-len;
                            y: 0;
                            height: 100%;
                            border-radius: parent.height / 2;
                            background: sb-touch.dragging ? #8a8f98
                                : (sb-touch.has-hover ? #6b7280 : #4b5563);
                        }
                        // Drag sensor over the WHOLE track, anchored to the track's
                        // fixed left edge (x: 0) so `mouse-x` is measured from a
                        // stationary origin — the same anti-feedback trick the ENTRY
                        // resize handle uses (a sensor pinned to the moving thumb would
                        // read a position a frame ahead of its own geometry). A press
                        // on the thumb drags from where it was grabbed (no jump); a
                        // press on the bare track centres the thumb on the cursor then
                        // drags. Each update writes env-body.viewport-x; the
                        // `scroll-from-thumb` inverse clamps to the scroll range.
                        sb-touch := TouchArea {
                            x: 0;
                            width: 100%;
                            height: 100%;
                            property <bool> dragging;
                            property <length> grab-offset;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left
                                    && e.kind == PointerEventKind.down) {
                                    self.grab-offset =
                                        (self.mouse-x >= sb-thumb.x
                                            && self.mouse-x <= sb-thumb.x + sb-thumb.width)
                                        ? self.mouse-x - sb-thumb.x
                                        : sb-track.thumb-len / 2;
                                    self.dragging = true;
                                    env-body.viewport-x = -root.sb-scroll-from-thumb(
                                        self.mouse-x - self.grab-offset,
                                        sb-track.track-w, sb-track.thumb-len, sb-track.max-scroll);
                                }
                                if (e.kind == PointerEventKind.up
                                    || e.kind == PointerEventKind.cancel) {
                                    self.dragging = false;
                                }
                            }
                            moved => {
                                if (self.dragging) {
                                    env-body.viewport-x = -root.sb-scroll-from-thumb(
                                        self.mouse-x - self.grab-offset,
                                        sb-track.track-w, sb-track.thumb-len, sb-track.max-scroll);
                                }
                            }
                        }
                    }
                }
            }
            // Signed in with zero Applications (issue #10): point the user at the
            // sidebar `+` instead of a blank matrix.
            if root.pane == "empty-apps" : Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No Applications yet — create one with + in the sidebar.";
                    color: #6b7280;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pane != "matrix" && root.pane != "empty-apps" : Rectangle {
                vertical-stretch: 1;
                Text {
                    text: root.body-copy;
                    color: #6b7280;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Diagnostic Log (ADR 0017): collapsible; the only diagnostic
            // surface. Read-only TextEdit → native select/copy; no clipboard dep.
            Rectangle {
                height: root.log-open ? 200px : 30px;
                background: root.dark ? #0e1115 : #e4e7eb;
                border-radius: 4px;
                VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Diagnostics";
                            color: #8a8f98; font-size: 11px;
                            vertical-alignment: center;
                        }
                        // Collapsed: the newest line is the status area. Expanded:
                        // a plain spacer (the full stream shows below).
                        if !root.log-open : Text {
                            // Content IS the accessible-label (no explicit override),
                            // so a view test can assert the latest line is shown.
                            text: root.log-latest;
                            color: #6b7280; font-size: 11px;
                            overflow: elide; horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.log-open : Rectangle { horizontal-stretch: 1; }
                        if root.log-open : ComboBox {
                            // Ordered by value: Error(1) Warn(2) Info(3). Default
                            // Info = show everything.
                            model: ["Error", "Warn", "Info"];
                            current-index: 2;
                            selected => { root.set-log-filter(self.current-index + 1); }
                        }
                        if root.log-open : Button {
                            text: "Clear";
                            clicked => { root.clear-log(); }
                        }
                        Button {
                            text: root.log-open ? "Hide ▾" : "Logs ▸";
                            clicked => { root.log-open = !root.log-open; }
                        }
                    }
                    if root.log-open : TextEdit {
                        read-only: true;
                        text: root.log-text;
                        vertical-stretch: 1;
                    }
                }
            }

            // Bottom session/status bar (issue #23): identity, SSO session time
            // remaining, a memory-only note, a manual-refresh / no-background-
            // polling note (ADR 0005), and the Drift/Aligned/Gap legend WITH
            // COUNTS. Counts come from Rust (derived from row states) — no Values.
            Rectangle {
                height: 28px;
                background: root.dark ? #0e1115 : #e4e7eb;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    spacing: 12px;
                    Text {
                        accessible-role: text;
                        accessible-label: "statusbar-identity";
                        text: root.identity != "" ? root.identity : "memory-only session";
                        color: root.identity != "" ? #c8ccd4 : #6b7280;
                        font-size: 11px; vertical-alignment: center;
                    }
                    Text {
                        accessible-role: text;
                        accessible-label: "statusbar-session";
                        text: "session: " + (root.session-remaining != "" ? root.session-remaining : "—");
                        color: #6b7280; font-size: 11px; vertical-alignment: center;
                    }
                    Text {
                        accessible-role: text;
                        accessible-label: "statusbar-memory-note";
                        text: "memory-only";
                        color: #6b7280; font-size: 11px; vertical-alignment: center;
                    }
                    Text {
                        accessible-role: text;
                        accessible-label: "statusbar-refresh-note";
                        text: "manual refresh · no background polling";
                        color: #6b7280; font-size: 11px; vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Legend WITH COUNTS. Each entry: a state-coloured dot + the
                    // "<State> <count>" text (the Text carries the count as its
                    // implicit accessible-label, so view tests can assert it).
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            min-width: 6px; max-width: 6px; height: 6px;
                            border-radius: 3px; background: Palette.dot-color("Aligned");
                            y: (parent.height - 6px) / 2;
                        }
                        Text {
                            text: "Aligned " + root.aligned-count;
                            color: #8a8f98; font-size: 11px; vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            min-width: 6px; max-width: 6px; height: 6px;
                            border-radius: 3px; background: Palette.dot-color("Drift");
                            y: (parent.height - 6px) / 2;
                        }
                        Text {
                            text: "Drift " + root.drift-count;
                            color: #8a8f98; font-size: 11px; vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            min-width: 6px; max-width: 6px; height: 6px;
                            border-radius: 3px; background: Palette.dot-color("Gap");
                            y: (parent.height - 6px) / 2;
                        }
                        Text {
                            text: "Gap " + root.gap-count;
                            color: #8a8f98; font-size: 11px; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Settings (issue #23): a dimmed full-window backdrop holding a CENTERED,
    // constrained-width card (~540px) — not the old full-bleed panel. The card
    // scrolls if the controls overflow a short window. All controls are unchanged;
    // only the chrome (centering, width cap, density) changed. No secret logic.
    if settings-open : Rectangle {
        width: 100%;
        height: 100%;
        // Click-catching dim backdrop; clicking outside the card closes settings.
        background: #0b0d11d8;
        TouchArea { clicked => { root.toggle-settings(); } }

        settings-card := Rectangle {
            // Bounded, centered card. Width is capped to a card; x/y center it in
            // the backdrop (it is not in a layout, so centre explicitly).
            accessible-role: text;
            accessible-label: "settings-card";
            width: min(540px, parent.width - 48px);
            // Cap the height so the card never fills the whole window; the inner
            // ScrollView handles overflow.
            height: min(620px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.dark ? #161a20 : #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.dark ? #23272f : #d8dce2;
            // Swallow backdrop clicks landing on the card (don't close).
            TouchArea {}

            ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    HorizontalLayout {
                        Text {
                            text: "Settings"; color: root.dark ? white : #14161a;
                            font-size: 18px; font-weight: 700;
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                        Button { text: "Close"; clicked => { root.toggle-settings(); } }
                    }

                    Text { text: "Identity Center"; color: #8a8f98; font-size: 12px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "SSO start URL"; color: #c8ccd4; width: 110px; vertical-alignment: center; }
                        start-url := LineEdit { text <=> root.sso-start-url; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Region"; color: #c8ccd4; width: 110px; vertical-alignment: center; }
                        region := LineEdit { text <=> root.sso-region; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Save accounts"; clicked => { root.save-sso(); } }
                    }

                    Text { text: "Applications"; color: #8a8f98; font-size: 12px; font-weight: 700; }
                    for app[i] in apps : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: app.name + (app.selected ? "  (selected)" : "");
                            color: app.selected ? #ffd479 : (root.dark ? white : #14161a);
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                        Button { text: "Select"; clicked => { root.select-app(i); } }
                        Button { text: "Remove"; clicked => { root.remove-app(i); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        new-app := LineEdit { placeholder-text: "New Application name"; horizontal-stretch: 1; }
                        Button { text: "Add application"; clicked => { root.add-app(new-app.text); } }
                    }
                    Text {
                        text: "Add or remove Environments from each Application's Manage window.";
                        color: #6b7280;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Text { text: "Preferences"; color: #8a8f98; font-size: 12px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Dark theme"; color: #c8ccd4; width: 110px; vertical-alignment: center; }
                        Switch {
                            checked: root.dark;
                            toggled => { root.set-theme(self.checked); }
                            accessible-label: "settings-theme";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Sort"; color: #c8ccd4; width: 110px; vertical-alignment: center; }
                        ComboBox {
                            model: ["Name", "Gap first"];
                            current-index: 0;
                            selected => { root.set-sort(self.current-index); }
                            accessible-label: "settings-sort";
                        }
                    }

                    // Read-write mode unlock (ADR 0004 / ADR 0032): off by default —
                    // v1 is read-only. Turning it on is the deliberate switch into
                    // read-write mode; the worker is the authoritative lock and refuses
                    // every write until it is on. Never persisted (read-only each launch).
                    Text { text: "Danger zone"; color: #d88; font-size: 12px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Read-write mode"; color: #c8ccd4; width: 110px; vertical-alignment: center; }
                        Switch {
                            checked: root.read-write;
                            toggled => { root.set-read-write(self.checked); }
                            accessible-label: "settings-read-write";
                        }
                    }
                    Text {
                        text: "Off = read-only (default). On lets Janitor write edits, always through the non-stomping safe-write engine. Resets to off on relaunch.";
                        color: #6b7280;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Non-modal pop-out (ADR 0013): everything about ONE Application. Bound to the
// app it opened for — the sidebar selection does not retarget it, so a
// discovered Environment can never land in the wrong Application. `+ Add env`
// runs guided Discovery (the user types only the Environment name; account /
// role / secret are discovered).
export component ManageWindow inherits Window {
    title: "Manage Application";
    icon: @image-url("../assets/icons/256.png"); // match MainWindow (ADR 0022)
    preferred-width: 620px;
    preferred-height: 440px;
    background: #14161a;

    in property <string> app-name;
    in property <[EnvRow]> envs;
    // Progress / masked result of the in-flight discovery ("" hides it).
    in property <string> discovery-status;
    // True when `discovery-status` is a terminal failure (no choices / session
    // error / expired) the user can step Back from — false for transient
    // progress like "Discovering…". Gates the Back button (ADR 0013).
    in property <bool> discovery-terminal;
    // Pending guided choice (ADR 0013): prompt ("" hides the picker), the
    // selectable presenter labels, and the index to pre-select (-1 = none).
    in property <string> choice-prompt;
    in property <[string]> choices;
    in property <int> choice-default;
    // Pending free-text Input (ADR 0025): prompt ("" hides the field) and the
    // remembered default *path* to pre-fill the text field with. Mutually
    // exclusive with the choice picker above (one question at a time).
    in property <string> input-prompt;
    in property <string> input-default;
    // env name + chosen Method index (0 = Secrets Manager, 1 = remote .env/SSM) →
    // Discovery fills the rest (ADR 0031 per-row method picker).
    callback add-env-discover(string, int);
    callback pick-choice(int);         // chosen index → AdvanceDiscovery
    callback provide-input(string);    // typed path → ProvideInput
    callback back-discovery();         // dismiss a terminal message to adjust/retry
    callback remove-env(int);
    callback rename-app(string);       // new name → Config::rename_application
    callback close-window();

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text { text: "Manage · " + root.app-name; color: white; font-size: 18px; }

        // Rename the Application. Seeded with the current name; the field is
        // re-seeded by `app-name` changing (so a refresh shows the saved name).
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Name"; color: #8a8f98; vertical-alignment: center; width: 60px; }
            rename-field := LineEdit {
                text: root.app-name;
                horizontal-stretch: 1;
                accepted => { root.rename-app(self.text); }
            }
            Button { text: "Rename"; clicked => { root.rename-app(rename-field.text); } }
        }

        Text { text: "ENVIRONMENTS"; color: #8a8f98; font-size: 11px; }
        if root.envs.length == 0 : Text {
            text: "No environments yet — add one below.";
            color: #6b7280;
        }
        for env[i] in root.envs : HorizontalLayout {
            spacing: 8px;
            Text { text: env.environment; color: white; width: 80px; }
            // The Method tag (ADR 0031) — which backend this env's Set lives in.
            Text { text: env.method; color: #7ea8d8; width: 44px; }
            Text { text: env.account-id; color: #9aa0aa; width: 120px; }
            Text { text: env.region; color: #9aa0aa; width: 84px; }
            Text { text: env.secret-id; color: #9aa0aa; horizontal-stretch: 1; overflow: elide; }
            Button { text: "Remove"; clicked => { root.remove-env(i); } }
        }

        HorizontalLayout {
            spacing: 8px;
            new-env := LineEdit {
                placeholder-text: "environment name (e.g. prod)";
                horizontal-stretch: 1;
            }
            // Per-row Method picker (ADR 0031 Decision 7): the chosen backend rides
            // on Discovery so the walk runs that method's tail. Default Secrets
            // Manager (index 0).
            add-method := ComboBox {
                model: ["Secrets Manager", "Remote .env / SSM"];
                current-index: 0;
                min-width: 170px;
            }
            Button {
                text: "+ Add env";
                clicked => {
                    root.add-env-discover(new-env.text, add-method.current-index);
                    new-env.text = "";
                }
            }
        }

        if root.discovery-status != "" : VerticalLayout {
            spacing: 6px;
            Text {
                text: root.discovery-status;
                color: #a3c0e0;
                wrap: word-wrap;
            }
            // A terminal message (no choices / session error / expired) is
            // retryable: Back dismisses it so the user can adjust and try again.
            if root.discovery-terminal : HorizontalLayout {
                Button { text: "Back"; clicked => { root.back-discovery(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Guided choice menu: one clickable row per label, the remembered
        // default marked. Clicking advances the walk (sends the index back).
        if root.choice-prompt != "" : VerticalLayout {
            spacing: 4px;
            Text { text: root.choice-prompt; color: #cdd3db; }
            for label[i] in root.choices : Button {
                text: (i == root.choice-default ? "● " : "○ ") + label;
                clicked => { root.pick-choice(i); }
            }
        }

        // Guided free-text Input (ADR 0025): a text field pre-filled with the
        // remembered path default. Enter or Submit sends the typed path back via
        // `provide-input`. Mutually exclusive with the choice picker above.
        if root.input-prompt != "" : VerticalLayout {
            spacing: 4px;
            Text { text: root.input-prompt; color: #cdd3db; }
            HorizontalLayout {
                spacing: 8px;
                input-field := LineEdit {
                    text: root.input-default;
                    horizontal-stretch: 1;
                    accepted => { root.provide-input(self.text); }
                }
                Button { text: "Submit"; clicked => { root.provide-input(input-field.text); } }
            }
        }

        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close-window(); } }
        }
    }
}
