{
  // Plain `cargo run` tasks — no debugger extension needed. Run via
  // Terminal → Run Task… (or bind a key). Output goes to the integrated terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Janitor (real AWS)",
      "type": "cargo",
      "command": "run",
      "args": ["-p", "janitor-gui"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "clear": true }
    },
    {
      "label": "Run Janitor (mock, offline)",
      "type": "cargo",
      "command": "run",
      "args": ["-p", "janitor-gui"],
      "options": { "env": { "JANITOR_MOCK": "1" } },
      "problemMatcher": ["$rustc"],
      "presentation": { "clear": true }
    },
    {
      "label": "Run Janitor (SSM remote .env)",
      "type": "cargo",
      "command": "run",
      "args": ["-p", "janitor-gui"],
      "options": { "env": { "JANITOR_SSM": "1" } },
      "problemMatcher": ["$rustc"],
      "presentation": { "clear": true }
    },
    {
      "label": "Build workspace",
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Test workspace",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
