{
  // Plain `cargo run` tasks — no debugger extension needed. Run via
  // Terminal → Run Task… (or bind a key). Output goes to the integrated terminal.
  //
  // The Slint shell moved to Circuit-Stitch/Janitor-slint (#106), so the tasks
  // that ran it live there now.
  "version": "2.0.0",
  "tasks": [
    {
      // Interactive (Milestone B): drive the SSM transport against a real box —
      // browser sign-in → discovery (pick JanitorSSM) → masked matrix. Reads stdin
      // for the menu + .env path, so it gets its own dedicated terminal panel. Add
      // "--reset-config" to the args to clear stale remembered picks.
      "label": "Run live-verify-ssm (SSM transport)",
      "type": "cargo",
      "command": "run",
      "args": ["-p", "janitor-ssm", "--bin", "live-verify-ssm"],
      "problemMatcher": ["$rustc"],
      "presentation": { "clear": true, "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Build workspace",
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Test workspace",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace", "--all-features"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
