# Rust
/target/
# The Swift binding generator is its own package outside the workspace (ADR 0035),
# so it builds into a target dir of its own.
/tools/uniffi-bindgen-swift/target/
**/*.rs.bk
*.pdb

# Packaging output (cargo-packager + the MSIX pack layout, ADR 0022 / 0034)
dist/

# Serena local agent tooling (per-developer, not project source)
/.serena/

# OS cruft
.DS_Store
Thumbs.db

# Icon model output (docs/icon): Blender's backup saves and the rendered PNGs,
# both rebuilt by key_ring.py. The model itself, key_ring.blend, stays tracked.
*.blend1
/docs/icon/renders/
